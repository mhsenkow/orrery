# https://editorconfig.org — quality-400 G5
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{woff,woff2,png,jpg,jpeg,gif,webp}]
insert_final_newline = false
trim_trailing_whitespace = false
