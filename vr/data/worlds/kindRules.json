{
  "version": 1,
  "why": "Named Solar-System kinds as an ordered table. First match wins. Axis fallbacks stay in planetKind.js because they are physics, not a body list. Adding a named world is a row here, not a regex in sim.",
  "named": [
    { "kind": "earth", "on": "ident", "re": "\\bearth\\b", "not": "super" },
    { "kind": "jupiter", "on": "name", "re": "\\bjupiter\\b" },
    { "kind": "saturn", "on": "name", "re": "\\bsaturn\\b", "not": "rhea|dione|tethys|iapetus|mimas|enceladus|titan|hyperion" },
    { "kind": "uranus", "on": "name", "re": "\\buranus\\b", "not": "miranda|ariel|umbriel|titania|oberon|uranian" },
    { "kind": "neptune", "on": "name", "re": "\\bneptune\\b", "not": "triton" },
    { "kind": "io", "on": "name", "re": "\\bio\\b", "not": "ion" },
    { "kind": "venus", "on": "name", "re": "venus" },
    { "kind": "mars", "on": "name", "re": "\\bmars\\b" },
    { "kind": "mercury", "on": "name", "re": "mercury" },
    { "kind": "moon", "on": "name", "re": "\\bluna\\b|\\bmoon\\b|selene" },
    { "kind": "enceladus", "on": "name", "re": "enceladus" },
    { "kind": "titan", "on": "name", "re": "\\btitan\\b" },
    { "kind": "pluto", "on": "name", "re": "\\bpluto\\b", "not": "charon" },
    { "kind": "triton", "on": "name", "re": "triton" },
    { "kind": "ganymede", "on": "name", "re": "ganymede" },
    { "kind": "callisto", "on": "name", "re": "callisto" },
    { "kind": "europa", "on": "name", "re": "europa" },
    { "kind": "iapetus", "on": "name", "re": "iapetus" },
    { "kind": "miranda", "on": "name", "re": "miranda" },
    { "kind": "mimas", "on": "name", "re": "mimas" },
    { "kind": "charon", "on": "name", "re": "charon" },
    { "kind": "phobos", "on": "name", "re": "phobos|deimos" },
    { "kind": "ceres", "on": "name", "re": "ceres" },
    { "kind": "eris", "on": "name", "re": "eris|sedna" },
    { "kind": "smallbody", "on": "name", "re": "arrokoth|bennu|67p" },
    { "kind": "rhea", "on": "name", "re": "rhea|dione|tethys|hyperion" },
    { "kind": "uranian", "on": "name", "re": "ariel|umbriel|titania|oberon|uranian" }
  ],
  "gas": ["gas", "jupiter", "saturn", "uranus", "neptune"],
  "whittaker": ["earth", "daisy", "generic"]
}
