{
  "name": "orrery-vr",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:fast",
    "test:fast": "node sim/test-fast.mjs",
    "test:watch": "node --watch sim/test-fast.mjs",
    "test:full": "node sim/test.mjs && node sim/test-worldParams.mjs",
    "test:sweep": "node sim/test-sweep.mjs",
    "smoke": "node sim/smoke.mjs",
    "test:origin": "node sim/origin-sketch-test.mjs",
    "test:deeptime": "node sim/deeptime.mjs --ticks=40",
    "test:dark": "node sim/dark-test.mjs",
    "test:dark-scenario": "node sim/dark-scenario.mjs",
    "orphan:suites": "node ../scripts/orphan-suites.mjs",
    "data": "node ../scripts/data.mjs",
    "calibrate": "node sim/calibrate.mjs",
    "calibrate:all": "node ../scripts/calibrate-all.mjs",
    "provenance": "node ../scripts/provenance.mjs",
    "provenance:ratchet": "node ../scripts/provenance.mjs --ratchet",
    "fidelity": "node ../scripts/provenance.mjs --ratchet && node ../scripts/calibrate-all.mjs && node ../scripts/golden-corpus.mjs && node ../scripts/parity-climate.mjs && node ../scripts/alloc-lint.mjs",
    "alloc:lint": "node ../scripts/alloc-lint.mjs",
    "determinism:lint": "node ../scripts/determinism-lint.mjs",
    "test:fidelity": "npm run fidelity",
    "determinism": "node ../scripts/determinism-audit.mjs --lint && node ../scripts/determinism-lint.mjs",
    "parity": "node ../scripts/parity-climate.mjs",
    "parity:gpu": "node ../scripts/parity-climate.mjs --require-gpu",
    "golden:corpus": "node ../scripts/golden-corpus.mjs",
    "golden": "node sim/headless.mjs --golden --ticks=40",
    "headless": "node sim/headless.mjs --ticks=100",
    "fetch-archive": "node ../scripts/fetch-exoarchive.mjs",
    "probe": "node ../scripts/thrive-probe.mjs --ticks=500",
    "probe-fire": "node ../scripts/thrive-probe.mjs --ticks=500 --fire",
    "fleet": "node ../scripts/fleet.mjs",
    "data:dry": "node ../scripts/data.mjs --dry-run"
  }
}
